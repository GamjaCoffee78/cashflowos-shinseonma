# ============================================================
# CashFlowOS — environment variables
# ------------------------------------------------------------
# Copy this file to `.env` (cp .env.example .env), then fill in the values.
# `.env` is gitignored — your real keys never get committed.
#
# THREE COMMON MISTAKES that break everything (avoid them):
#   1) A trailing newline or space in a key. Copy the value EXACTLY, no extra line.
#      (A stray newline is an illegal HTTP header and crashes every request.)
#   2) Using the /rest/v1 URL. SUPABASE_URL is the BASE project URL
#      (https://xxxx.supabase.co) — NOT https://xxxx.supabase.co/rest/v1.
#   3) Using the anon / publishable key. The app needs the service_role (secret)
#      key. The anon key can't read past security rules → you'll see an empty app.
# ============================================================

# ---- Supabase (the O & E steps) ----
# Supabase → Project Settings → Data API → Project URL. Base URL only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase → Project Settings → API Keys → service_role → Reveal & copy.
# This is a SECRET (it bypasses all row security). Server-only — never in a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service_role-secret-key

# ---- The lock on the door ----
# Any phrase you like — this is the passcode for the web app (see /login).
# Leave it BLANK to run with no lock (the app shows a calm setup note instead).
# "A lock on the door, not bank-grade auth."
APP_PASSCODE=change-me

# ---- Google sign-in (recommended — replaces the passcode) ----
# Set BOTH of these and the passcode is switched off: only the Google accounts
# listed in ALLOWED_EMAILS can open the app. Create them at
# console.cloud.google.com → APIs & Services → Credentials → Create credentials →
# OAuth client ID → "Web application". Authorised redirect URI:
#   https://YOUR-APP.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who may sign in. Comma-separated emails, or "@yourdomain.com" for a whole
# Google Workspace domain. EMPTY = NOBODY (fails closed). Remove someone and
# they're locked out on their next click.
ALLOWED_EMAILS=
# Optional. Signs the login cookie (defaults to GOOGLE_CLIENT_SECRET). Any long
# random string. Changing it signs everyone out.
AUTH_SECRET=
# Optional. Pin the sign-in URL to one domain (e.g. https://app.okmaya.com) if
# you use a custom domain. Otherwise the current host is used.
AUTH_URL=

# ---- Claude (the brain) ----
# console.anthropic.com → API Keys. Powers the photo reader + Abang bot.
# Missing? Every AI surface degrades to a calm "add your key" message — never a crash.
ANTHROPIC_API_KEY=sk-ant-...

# ---- Telegram (Abang + photo filing) ----
# Talk to @BotFather on Telegram → /newbot → copy the token it gives you.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# A random secret string YOU invent. Telegram sends it back on every webhook so
# the app can reject fake calls. `npm run webhook:set` registers it for you.
TELEGRAM_WEBHOOK_SECRET=invent-a-long-random-string
# Comma-separated Telegram numeric user IDs allowed to use the bot (fail-closed:
# anyone not on this list is refused). Get yours from @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=111111111,222222222
# Your own Telegram numeric ID — where the daily brief + notifications are sent.
OWNER_CHAT_ID=111111111
# Optional: extra chat IDs (a team group, etc.) to also receive broadcasts.
# Comma-separated. Leave blank if you don't need it.
TELEGRAM_TEAM_CHAT_IDS=

# Optional: a TEAMMATE'S OWN bot token, so the personal "today" digest
# (Calendar / Production / Social Calendar / Events — see abang/config.ts →
# todayBriefRecipients) sends from THEIR bot, not the one above. Get it the
# same way (that person messages @BotFather → /newbot). Leave blank and the
# digest is simply skipped (logged, never sent from the wrong bot).
TELEGRAM_HUIYEE_BOT_TOKEN=

# ---- The daily cron ----
# REQUIRED. A random secret that guards /api/cron-daily (which can spend credit,
# so it fails CLOSED — no secret set means the endpoint returns 401 to everyone).
# Vercel Cron sends it automatically once you set the same value in Vercel env.
CRON_SECRET=invent-another-long-random-string

# ---- The autonomy dial ----
# The threshold (in RM) between 🟢 auto-file and 🟡 ask-first for expenses.
# Spend at or under this files itself; over this asks you first. Default 200.
EXPENSE_APPROVAL_THRESHOLD=200
