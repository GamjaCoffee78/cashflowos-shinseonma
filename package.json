    "import:production": "node --env-file-if-exists=.env scripts/import-production.mjs",
    "sync:tiktok": "node --env-file-if-exists=.env --conditions react-server --import tsx scripts/sync-tiktok.mts",
    "sync:meta": "node --env-file-if-exists=.env --conditions react-server --import tsx scripts/sync-meta.mts",
    "sync:calendar": "node --env-file-if-exists=.env --conditions react-server --import tsx scripts/sync-calendar.mts",
    "purge:demo": "node --env-file-if-exists=.env scripts/purge-demo.mjs",
